#!/usr/bin/env bash
# atelier-chrome — le navigateur de l'Atelier, en stdio.
#
# Chaque client MCP qui déclare ce navigateur (une conversation de l'Atelier,
# VS Code, le terminal, un agent wikichat, la passerelle) lance ce script. Il
# démarre `chrome-devtools-mcp` (serveur officiel, Apache-2.0) avec un Chrome
# sans écran à lui, jamais le profil de la personne. Chrome parle au serveur
# par un tube, et meurt avec lui. Chrome n'est lancé qu'au premier outil qui
# en a besoin ; tant que l'agent ne navigue pas, seul le serveur tourne
# (environ 120 Mo).
#
# L'écran d'une conversation (docs/navigateur-atelier.md, « Écran en
# direct »). Quand le processus appartient à une conversation (ATELIER_SESSION,
# sinon CLAUDE_CODE_SESSION_ID), le lanceur :
#
# - garde un profil par conversation, $RACINE/conversation.<id>, tant que la
#   conversation vit : les sessions des sites (connexions) survivent à la fin
#   du processus et au tour suivant. Un verrou (flock) le réserve au processus
#   qui l'utilise ; un second processus de la même conversation reçoit un
#   profil jetable, sans écran. Un profil de conversation qu'aucun lanceur
#   n'a ouvert depuis ATELIER_CHROME_PROFIL_JOURS jours (défaut 14) est
#   balayé ;
# - fait ouvrir à Chrome, en plus du tube, un port de débogage sur 127.0.0.1
#   seulement, choisi par le système (--remote-debugging-port=0), que Chrome
#   écrit dans <profil>/DevToolsActivePort ;
# - place toujours le filtre atelier-chrome-onglets.mjs devant le serveur :
#   c'est lui qui publie l'association conversation -> port dans
#   $RACINE/ecrans/<id>.json (0600), et qui retient les actions de l'agent
#   pendant que la personne a la main ($RACINE/main/<id>.json).
#
# À la sortie, tout est rangé : fiche de l'écran, port (Chrome meurt avec son
# tube), profil jetable. Seul le profil de la conversation reste.
#
# Deux rôles, selon la variable ATELIER_CHROME_ROLE :
#
# - serveur (défaut) : choisit les options, crée le profil sous
#   $RACINE/profil.<pid>, lance le serveur, relaie SIGTERM/SIGINT/SIGHUP, et
#   efface le profil en sortant. Les profils laissés par un processus tué
#   (SIGKILL) sont balayés au lancement suivant.
# - navigateur : c'est ce script que le serveur prend pour Chrome
#   (`--executablePath`). Il compte les Chrome vivants de ce compte et refuse,
#   avec un message que l'agent lit, d'en ouvrir plus que ATELIER_CHROME_MAX ;
#   sinon il cède la place au vrai Chrome (exec), sans rien garder entre eux.
#
# Réglages (environnement) :
#   ATELIER_CHROME_MAX       Chrome simultanés permis pour ce compte (défaut 6)
#   ATELIER_CHROME_ONGLETS_MAX  onglets permis par conversation (défaut 8 ;
#                            0 = sans plafond). Tenu par le filtre
#                            atelier-chrome-onglets.mjs, placé entre le client
#                            et le serveur : au-delà, new_page rend « ferme un
#                            onglet » sans rien ouvrir.
#   ATELIER_CHROME_FILTRE    chemin du filtre (sinon à côté de ce script, puis
#                            ~/work/atelier-src/bin)
#   ATELIER_CHROME_OUTILS    courant (défaut) | complet | minimal
#   ATELIER_CHROME_PORTEE    conversation (défaut) | passerelle
#   ATELIER_CHROME_RESEAU    tout (défaut en conversation) | public (défaut
#                            pour la passerelle : adresses privées refusées)
#   ATELIER_CHROME_BIN       Chrome à utiliser (sinon cherché)
#   ATELIER_CHROME_MCP_JS    point d'entrée de chrome-devtools-mcp (sinon cherché)
#   ATELIER_CHROME_JOURNAL   fichier de journal du serveur (aucun par défaut)
#   ATELIER_CHROME_RACINE    dossier des profils et du comptage
#   ATELIER_CHROME_WS / ATELIER_CHROME_URL  se rattacher à un Chrome existant
#                            (ws://… ou http://…) au lieu d'en lancer un
#   ATELIER_CHROME_ECRAN     1 (défaut en conversation) | 0 : écran en direct
#                            et profil gardé par conversation
#   ATELIER_CHROME_PROFIL_JOURS  jours avant de balayer un profil de
#                            conversation inutilisé (défaut 14)
#   ATELIER_CHROME_VERIFIER=1  vérifie l'installation, n'ouvre rien, sort.
#
# Le plafond de navigateurs atteint, Chrome refuse de démarrer : l'agent reçoit alors de
# chrome-devtools-mcp une erreur de protocole (« Target closed »), pas notre
# phrase, que seul le journal du serveur garde (ATELIER_CHROME_JOURNAL).
set -u

WORK="${ATELIER_WORK:-$HOME/work}"
RACINE="${ATELIER_CHROME_RACINE:-${TMPDIR:-/tmp}/atelier-chrome-$(id -u)}"
MAX="${ATELIER_CHROME_MAX:-6}"
SOI="$(readlink -f "$0" 2>/dev/null || echo "$0")"

dire() { printf 'atelier-chrome : %s\n' "$*" >&2; }

# Le Chrome du volume d'abord : le pod ne tourne pas sur l'image de l'Atelier,
# et un Chrome posé dans le système (/usr/bin/google-chrome) disparaît à son
# redémarrage. `atelier-init.sh` en installe un dans ~/work/.tools par
# `npx @puppeteer/browsers install` (chrome-headless-shell par défaut, ou
# Chrome for Testing) ; la version la plus récente l'emporte.
chrome_du_volume() {
  local c v
  for c in "$WORK"/.tools/chrome-headless-shell/linux*/chrome-headless-shell-linux64/chrome-headless-shell \
    "$WORK"/.tools/chrome/linux*/chrome-linux64/chrome; do
    [ -x "$c" ] || continue
    v="${c%/*/*}"   # …/linux-153.0.8010.47
    v="${v##*/}"
    printf '%s %s\n' "${v#*-}" "$c"
  done | sort -k1,1Vr | cut -d' ' -f2-
}

trouver_chrome() {
  local c
  if [ -n "${ATELIER_CHROME_BIN:-}" ]; then
    [ -x "$ATELIER_CHROME_BIN" ] && { echo "$ATELIER_CHROME_BIN"; return 0; }
    return 1
  fi
  while IFS= read -r c; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  done <<EOF
$(chrome_du_volume)
EOF
  for c in google-chrome google-chrome-stable chromium chromium-browser; do
    command -v "$c" >/dev/null 2>&1 && { command -v "$c"; return 0; }
  done
  for c in /opt/google/chrome/chrome; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  return 1
}

trouver_serveur() {
  local c
  if [ -n "${ATELIER_CHROME_MCP_JS:-}" ]; then
    [ -f "$ATELIER_CHROME_MCP_JS" ] && { echo "$ATELIER_CHROME_MCP_JS"; return 0; }
    return 1
  fi
  for c in \
    "${ATELIER_OUTILS:-/opt/atelier/outils}/chrome-devtools-mcp" \
    "$WORK/.tools/chrome-devtools-mcp" \
    "$WORK/mcp/tools"; do
    c="$c/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js"
    [ -f "$c" ] && { echo "$c"; return 0; }
  done
  return 1
}

# Le node de l'Atelier d'abord : celui du système peut être trop ancien
# (Node 18 sur le pod, que chrome-devtools-mcp refuse — il exige 20.19+).
trouver_node() {
  local c
  for c in "${ATELIER_NODE:-}" "${ATELIER_NODE_DIR:+$ATELIER_NODE_DIR/bin/node}" \
    "$WORK/bin/node" "$(command -v node 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] || continue
    majeure="$("$c" -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
    [ "${majeure:-0}" -ge 20 ] 2>/dev/null && { echo "$c"; return 0; }
  done
  return 1
}

# Le filtre du plafond d'onglets : à côté du lanceur (dépôt), ou dans la
# source de l'Atelier (le lanceur est copié seul dans ~/work/bin).
trouver_filtre() {
  local c
  for c in "${ATELIER_CHROME_FILTRE:-}" "${SOI%/*}/atelier-chrome-onglets.mjs" \
    "$WORK/atelier-src/bin/atelier-chrome-onglets.mjs"; do
    [ -n "$c" ] && [ -f "$c" ] && { echo "$c"; return 0; }
  done
  return 1
}

# Un pid n'est compté que s'il est encore un Chrome : un pid réutilisé par un
# autre programme ne doit pas bloquer l'ouverture d'un navigateur.
est_un_chrome() {
  [ -r "/proc/$1/cmdline" ] && tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q chrome
}

# --- rôle navigateur ------------------------------------------------------
if [ "${ATELIER_CHROME_ROLE:-serveur}" = "navigateur" ]; then
  CHROME="$(trouver_chrome)" || { dire "aucun Chrome sur cette machine (ATELIER_CHROME_BIN)"; exit 127; }
  mkdir -p "$RACINE/navigateurs" && chmod 700 "$RACINE"
  exec 9>"$RACINE/verrou"
  command -v flock >/dev/null 2>&1 && flock -w 10 9
  ouverts=0
  for f in "$RACINE"/navigateurs/*; do
    [ -e "$f" ] || continue
    p="${f##*/}"
    if est_un_chrome "$p"; then ouverts=$((ouverts + 1)); else rm -f "$f"; fi
  done
  if [ "$ouverts" -ge "$MAX" ]; then
    dire "$ouverts navigateurs déjà ouverts sur ce pod, pour $MAX permis. Fermez une" \
      "conversation qui s'en sert (ou attendez qu'elle s'éteigne), puis réessayez."
    exit 75
  fi
  : > "$RACINE/navigateurs/$$"
  exec 9>&-
  unset ATELIER_CHROME_ROLE
  # L'écran : en plus du tube de puppeteer, un port de débogage en boucle
  # locale, choisi par le système. Chrome l'écrit dans DevToolsActivePort, que
  # le filtre publie pour l'Atelier. Ajouté ici, après que puppeteer a posé
  # --remote-debugging-pipe : lui passer un --remote-debugging-* lui aurait
  # fait retirer son tube.
  if [ "${ATELIER_CHROME_ECRAN_PORT:-0}" = "1" ]; then
    set -- "$@" --remote-debugging-port=0 --remote-debugging-address=127.0.0.1
  fi
  unset ATELIER_CHROME_ECRAN_PORT
  # chrome-headless-shell est toujours sans écran et ne connaît pas le mode
  # « new » que demande puppeteer (--headless=new) : on lui passe --headless.
  if [ "${CHROME##*/}" = "chrome-headless-shell" ]; then
    arguments=()
    for a in "$@"; do
      case "$a" in
        --headless=*) arguments+=(--headless) ;;
        *) arguments+=("$a") ;;
      esac
    done
    set -- "${arguments[@]}"
  fi
  exec "$CHROME" "$@"
fi

# --- rôle serveur ---------------------------------------------------------
NODE="$(trouver_node)" || { dire "aucun node 20 ou plus récent (ATELIER_NODE)"; exit 127; }
SERVEUR="$(trouver_serveur)" || {
  dire "chrome-devtools-mcp n'est pas installé (npm install --prefix $WORK/.tools/chrome-devtools-mcp chrome-devtools-mcp)"
  exit 127
}
trouver_chrome >/dev/null || { dire "aucun Chrome sur cette machine (ATELIER_CHROME_BIN)"; exit 127; }

portee="${ATELIER_CHROME_PORTEE:-conversation}"
reseau="${ATELIER_CHROME_RESEAU:-}"
[ -n "$reseau" ] || { [ "$portee" = "passerelle" ] && reseau=public || reseau=tout; }

# Rattachement à un Chrome qu'on possède déjà : une adresse donnée par
# l'environnement, ou écrite pour cette conversation dans
# $RACINE/attache/<ATELIER_SESSION>. Sinon, le serveur lance son propre
# Chrome, par un tube.
attache="${ATELIER_CHROME_WS:-${ATELIER_CHROME_URL:-}}"
if [ -z "$attache" ] && [ -n "${ATELIER_SESSION:-}" ] && [ -r "$RACINE/attache/$ATELIER_SESSION" ]; then
  attache="$(head -n1 "$RACINE/attache/$ATELIER_SESSION")"
fi

# La conversation de ce processus : celle de l'Atelier, sinon celle du CLI
# (VS Code, terminal). Même forme que dans l'Atelier (apps/passage.py).
CONV="${ATELIER_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}"
case "$CONV" in
  "" | [!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) CONV="" ;;
esac
[ "${#CONV}" -le 120 ] || CONV=""
ECRAN="${ATELIER_CHROME_ECRAN:-1}"
[ "$ECRAN" = "1" ] || ECRAN=0
# La passerelle sert d'autres clients qu'une conversation ; un Chrome rattaché
# n'est pas le nôtre : ni l'un ni l'autre n'a d'écran.
if [ -z "$CONV" ] || [ "$portee" = "passerelle" ] || [ -n "$attache" ]; then
  ECRAN=0
fi

ONGLETS="${ATELIER_CHROME_ONGLETS_MAX:-8}"
FILTRE=""
if [ "$ONGLETS" != "0" ] || [ "$ECRAN" = "1" ]; then
  FILTRE="$(trouver_filtre)" || {
    FILTRE=""
    dire "filtre du navigateur introuvable (atelier-chrome-onglets.mjs) : ni plafond d'onglets, ni écran"
    ECRAN=0
  }
fi

if [ "${ATELIER_CHROME_VERIFIER:-}" = "1" ]; then
  printf 'node=%s\nserveur=%s\nchrome=%s\nonglets=%s\nfiltre=%s\necran=%s\n' \
    "$NODE" "$SERVEUR" "$(trouver_chrome)" "$ONGLETS" "${FILTRE:-aucun}" "$ECRAN"
  exit 0
fi

mkdir -p "$RACINE" && chmod 700 "$RACINE"
mkdir -p -m 700 "$RACINE/ecrans" "$RACINE/main"
# Les profils d'un lanceur tué sans pouvoir ranger (SIGKILL, OOM). Le lanceur
# mort ne suffit pas : son serveur et son Chrome lui survivent jusqu'à ce que
# leur client ferme le tube. On n'efface donc qu'un profil qu'aucun processus
# ne nomme plus sur sa ligne de commande.
for d in "$RACINE"/profil.*; do
  [ -d "$d" ] || continue
  kill -0 "${d##*.}" 2>/dev/null && continue
  grep -qsF -- "$d" /proc/[0-9]*/cmdline || rm -rf "$d"
done
# Les fiches d'écran d'un filtre mort (tué sans pouvoir ranger).
for f in "$RACINE"/ecrans/*.json; do
  [ -e "$f" ] || continue
  p="$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$f" 2>/dev/null)"
  if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then
    rm -f "$f"
  fi
done
# Les profils de conversation qu'aucun lanceur n'a ouverts depuis longtemps,
# et que personne ne tient (verrou libre). Le verrou est touché à chaque
# ouverture : sa date est celle du dernier usage.
JOURS="${ATELIER_CHROME_PROFIL_JOURS:-14}"
if command -v flock >/dev/null 2>&1; then
  for d in "$RACINE"/conversation.*; do
    [ -d "$d" ] || continue
    [ -n "$(find "$d.verrou" -maxdepth 0 -mtime +"$JOURS" 2>/dev/null)" ] || continue
    ( flock -n 7 || exit 0; rm -rf "$d"; rm -f "$d.verrou" ) 7>>"$d.verrou" 2>/dev/null
  done
fi

PROFIL=""
JETABLE=1
if [ "$ECRAN" = "1" ]; then
  PROFIL="$RACINE/conversation.$CONV"
  mkdir -p -m 700 "$PROFIL"
  # Le verrou est hérité par le serveur et par Chrome : il tient tant que l'un
  # d'eux vit, même si ce lanceur est tué.
  exec 8>"$PROFIL.verrou"
  if command -v flock >/dev/null 2>&1 && ! flock -n 8; then
    dire "le navigateur de cette conversation est déjà ouvert par un autre processus :" \
      "profil jetable, sans écran"
    exec 8>&-
    PROFIL=""
    ECRAN=0
  else
    JETABLE=0
    # Un port d'une vie antérieure ne doit pas être publié.
    rm -f "$PROFIL/DevToolsActivePort"
  fi
fi
if [ -z "$PROFIL" ]; then
  PROFIL="$RACINE/profil.$$"
  mkdir -m 700 "$PROFIL"
fi
case "$attache" in
  ws://*|wss://*) args=(--wsEndpoint "$attache") ;;
  http://*|https://*) args=(--browserUrl "$attache") ;;
  *) args=(--headless --userDataDir "$PROFIL" --executablePath "$SOI" --viewport 1280x720) ;;
esac
args+=(
  --no-usage-statistics
  --no-performance-crux
  --redact-network-headers
  --screenshotFormat jpeg
  --screenshotQuality 80
  --screenshotMaxWidth 1280
  --screenshotMaxHeight 2000
)
case "${ATELIER_CHROME_OUTILS:-courant}" in
  minimal) args+=(--slim) ;;
  complet) ;;
  *)
    # 24 outils au lieu de 30 : sans traces de performance, instantanés de
    # mémoire ni émulation, on économise ~2 000 jetons de schémas par
    # conversation. Et sans identifiant de page obligatoire : un serveur par
    # conversation n'a qu'un agent à servir.
    args+=(--no-page-id-routing --no-category-performance --no-category-memory --no-category-emulation)
    ;;
esac
if [ "$reseau" = "public" ]; then
  # Refuse d'emblée les adresses du pod et du namespace : boucle locale,
  # plages privées, lien local (métadonnées), noms sans point (services du
  # cluster), .local/.internal. C'est un contrôle des adresses demandées,
  # pas un pare-feu : une redirection depuis un site public passe encore.
  args+=(--blockedUrlPattern '*://(localhost|0\.0\.0\.0|127\..*|10\..*|192\.168\..*|172\.(?:1[6-9]|2[0-9]|3[01])\..*|169\.254\..*|100\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\..*|\[.*\]|[^.]+|.*\.local|.*\.internal|.*\.localhost):*/*')
fi
# Où les outils peuvent écrire (captures, traces) : le dossier temporaire, et
# le dossier du projet en conversation — pas au-delà.
args+=(--workspace "${TMPDIR:-/tmp}")
if [ "$portee" != "passerelle" ] && [ "$PWD" != "/" ] && [ "$PWD" != "$HOME" ]; then
  args+=(--workspace "$PWD")
fi
[ -n "${ATELIER_CHROME_JOURNAL:-}" ] && args+=(--logFile "$ATELIER_CHROME_JOURNAL")

export CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS=1
export CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1
export ATELIER_CHROME_ROLE=navigateur
export ATELIER_CHROME_RACINE="$RACINE"
export ATELIER_CHROME_MAX="$MAX"
export ATELIER_CHROME_ONGLETS_MAX="$ONGLETS"
if [ "$ECRAN" = "1" ]; then
  export ATELIER_CHROME_ECRAN_PORT=1
  export ATELIER_CHROME_CONVERSATION="$CONV"
  export ATELIER_CHROME_PROFIL="$PROFIL"
else
  unset ATELIER_CHROME_ECRAN_PORT ATELIER_CHROME_CONVERSATION ATELIER_CHROME_PROFIL
fi

enfant=""
filtre_pid=""
ranger() {
  if [ "$JETABLE" = "1" ]; then
    rm -rf "$PROFIL"
    return
  fi
  rm -f "$PROFIL/DevToolsActivePort"
  # La fiche de l'écran, si le filtre n'a pas pu la retirer lui-même.
  fiche="$RACINE/ecrans/$CONV.json"
  if [ -n "$filtre_pid" ] && grep -qs "\"pid\":$filtre_pid[,}]" "$fiche"; then
    rm -f "$fiche"
  fi
}
arreter() {
  [ -n "$enfant" ] && kill -TERM "$enfant" 2>/dev/null
  [ -n "$enfant" ] && wait "$enfant" 2>/dev/null
  exit 143
}
trap ranger EXIT
trap arreter TERM INT HUP

# En tâche de fond pour pouvoir relayer les signaux ; l'entrée standard est
# donnée explicitement, sans quoi bash la remplacerait par /dev/null. Le
# filtre d'onglets, s'il y en a un, lance le serveur et lui relaie tout.
if [ -n "$FILTRE" ]; then
  "$NODE" "$FILTRE" "$NODE" "$SERVEUR" "${args[@]}" <&0 &
else
  "$NODE" "$SERVEUR" "${args[@]}" <&0 &
fi
enfant=$!
[ -n "$FILTRE" ] && filtre_pid="$enfant"
wait "$enfant"
code=$?
enfant=""
exit "$code"
