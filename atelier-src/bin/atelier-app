#!/bin/sh
# Les artefacts des projets, pour un agent qui n'a pas les outils MCP.
#
#   atelier-app liste    [projet]
#   atelier-app creer    <projet> <nom> [autonome|serveur]
#   atelier-app verifier <projet>
#   atelier-app demarrer <projet> <nom> [--forcer]
#   atelier-app arreter  <projet> <nom> [--forcer]
#   atelier-app journal  <projet> <nom> [lignes]
#   atelier-app montrer           <nom> [chemin]
#   atelier-app ouvrir-navigateur <nom> [chemin]
#
# Un artefact est un dossier <projet>/artifacts/<nom>/, servi sur l'hôte des
# applications : ses fichiers en bac à sable, ou, s'il porte un
# artefact.json de service, le processus que l'Atelier lance pour lui. Ce
# script ne fait que parler à l'API locale de l'Atelier, avec la clé du
# propriétaire lue sur le disque : il ne lance rien lui-même.
#
# L'auteur est $WIKICHAT_AGENT (ou $ATELIER_AUTEUR) : on n'agit pas sur
# l'artefact d'une autre conversation sans --forcer.
#
# `montrer` et `ouvrir-navigateur` passent par les commandes de l'Atelier
# (/v1/commandes), comme les outils atelier_montrer et
# atelier_navigateur_ouvrir, avec les mêmes gardes : profil code, et le projet
# est celui de la conversation ($ATELIER_SESSION, ou $CLAUDE_CODE_SESSION_ID
# hors de l'Atelier), jamais un argument. `montrer` ouvre la création dans le
# panneau de la conversation ; `ouvrir-navigateur` rend une adresse d'entrée à
# usage unique (deux minutes) à ouvrir avec le navigateur de l'agent.
#
# Déposé dans ~/work/bin/ par install/atelier-init.sh.
set -u
WORK="${ATELIER_WORK:-$HOME/work}"
URL="${ATELIER_URL:-http://127.0.0.1:${ATELIER_PORT:-8787}}"
AUTEUR="${ATELIER_AUTEUR:-${WIKICHAT_AGENT:-}}"

CLE=""
for f in "$WORK/secrets/atelier_owner_key" "$WORK/.secrets/atelier_owner_key"; do
  if [ -r "$f" ]; then CLE=$(tr -d '\r\n' < "$f"); break; fi
done
if [ -z "$CLE" ]; then
  echo "atelier-app : clé du propriétaire introuvable dans $WORK/.secrets" >&2
  exit 1
fi

appel() {
  # $1 méthode, $2 chemin. La clé passe par un en-tête lu sur l'entrée
  # standard : elle n'apparaît pas dans la liste des processus.
  printf 'Authorization: Bearer %s\n' "$CLE" | curl -sS -X "$1" -H @- \
    -w '\n' --max-time 120 "$URL$2"
}

encoder() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

usage() {
  sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

commande_atelier() {
  # $1 commande, $2 arguments en JSON. La conversation et le profil voyagent
  # en en-têtes, comme depuis la porte MCP ; un refus sort en code 1.
  conversation=$(printf '%s' "${ATELIER_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}" | tr -d '\r\n')
  if [ -z "$conversation" ]; then
    echo "atelier-app : conversation inconnue (ni ATELIER_SESSION ni CLAUDE_CODE_SESSION_ID)" >&2
    exit 2
  fi
  reponse=$(printf 'Authorization: Bearer %s\nX-Atelier-Conversation: %s\nX-Atelier-Profil: code\nContent-Type: application/json\n' \
      "$CLE" "$conversation" \
    | curl -sS -X POST -H @- --data-binary "{\"arguments\": $2}" \
      -w '\n%{http_code}' --max-time 120 "$URL/v1/commandes/$1") || exit 1
  statut=$(printf '%s\n' "$reponse" | tail -n 1)
  printf '%s\n' "$reponse" | sed '$d'
  [ "$statut" -lt 400 ] 2>/dev/null || exit 1
}

json() {
  # Un objet JSON de paires nom valeur, valeurs vides omises.
  python3 -c 'import json, sys; a = sys.argv[1:]; print(json.dumps({a[i]: a[i + 1] for i in range(0, len(a), 2) if a[i + 1]}, ensure_ascii=False))' "$@"
}

suite_auteur() {
  # Les paramètres de voisinage : l'auteur, et --forcer s'il est demandé.
  q="auteur=$(encoder "$AUTEUR")"
  for a in "$@"; do
    [ "$a" = "--forcer" ] && q="$q&forcer=true"
  done
  if [ "${q#*forcer}" = "$q" ]; then q="$q&forcer=false"; fi
  printf '%s' "$q"
}

commande="${1:-}"
[ -n "$commande" ] || usage
shift
case "$commande" in
  liste)
    if [ -n "${1:-}" ]; then appel GET "/v1/apps?slug=$1"; else appel GET "/v1/apps"; fi ;;
  verifier)
    [ -n "${1:-}" ] || usage
    appel GET "/v1/apps?slug=$1" ;;
  creer)
    [ -n "${2:-}" ] || usage
    appel POST "/v1/apps/$1/$2/creer?mode=${3:-autonome}&auteur=$(encoder "$AUTEUR")" ;;
  demarrer)
    [ -n "${2:-}" ] || usage
    p="$1"; n="$2"; shift 2
    appel POST "/v1/apps/$p/$n/demarrer?attendre=true&$(suite_auteur "$@")" ;;
  arreter)
    [ -n "${2:-}" ] || usage
    p="$1"; n="$2"; shift 2
    appel POST "/v1/apps/$p/$n/arreter?$(suite_auteur "$@")" ;;
  journal)
    [ -n "${2:-}" ] || usage
    appel GET "/v1/apps/$1/$2/journal?lignes=${3:-200}" ;;
  montrer)
    [ -n "${1:-}" ] || usage
    commande_atelier atelier_montrer "$(json nom "$1" chemin "${2:-}")" ;;
  ouvrir-navigateur)
    [ -n "${1:-}" ] || usage
    commande_atelier atelier_navigateur_ouvrir "$(json chemin "$1/${2:-}")" ;;
  *)
    usage ;;
esac
