# Caches Python
__pycache__/
*.py[cod]
*.egg-info/

# Scratch de déploiement : découpes base64, payloads MCP, uploads temporaires.
# Ces fichiers sont régénérés à chaque passe, ils n'ont pas à être versionnés.
.appchunk*.txt
.b64_*
.tmp_*
.tmp-upload/
.tmp_gw_upload/
.deploy-atelier-b64/
.deploy_gen.py
.exec_deploy_*
.mcp_write_*

# Scripts de déploiement jetables : l'installation passe par l'image.
deploy-patches/

# Réglages Claude Code propres à la machine : ni suivis, ni ignorés jusqu'ici.
.claude/settings.local.json

# État local de wikichat et configuration MCP propre à la machine
.wikichat/
.mcp.json

# Divers
*.log

# Ce que Claude Code dépose localement : worktrees des agents, réglages du poste.
.claude/worktrees/
.claude/settings.local.json

# Sauvegardes de configuration MCP faites à la main.
*.bak-*
