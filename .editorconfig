# Mêmes réglages sur toutes les machines : le dépôt se développe sous Windows
# et se déploie sur un pod Linux (voir .gitattributes pour les fins de ligne).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Deux espaces en fin de ligne forcent un retour à la ligne en Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
